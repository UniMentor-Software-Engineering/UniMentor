# Copy this file to .env and fill in the values. Never commit .env.

# Runtime environment: development | test | production
NODE_ENV=development

# Port the Express server listens on (Render injects its own PORT)
PORT=3000

# PostgreSQL connection string (local Postgres, or the Render "External Database URL")
DATABASE_URL=postgres://unimentor:unimentor@localhost:5432/unimentor

# Set to true when connecting to a database that requires SSL
# (e.g. the Render external URL from your machine). Render's internal URL does not need it.
DB_SSL=false

# Secret used to sign JWTs (ADR 4). Use a long random value in production.
JWT_SECRET=change-me

# Frontend origin(s) allowed by CORS with credentials (ADR 4), comma-separated.
# Local: Live Server / static server. Production: the Vercel URL (required at startup).
# In production the pages reach the API through the Vercel proxy (frontend/vercel.json),
# so the browser sees one site; this value still matters for direct calls and the email links.
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# University email domains allowed to register (CU-01), comma-separated.
# unimentor.edu is for development only: nobody controls it, so anyone could use it.
ALLOWED_EMAIL_DOMAINS=myuax.com,unimentor.edu

# Email notifications (P5, ADR 6). Without SENDGRID_API_KEY every email is only written
# to the log (ConsoleProvider), so a development machine never sends real email.
# SENDGRID_API_KEY=SG.xxxxx
# Sender: must be a verified sender (or domain) in the SendGrid account.
EMAIL_FROM=UniMentor <no-reply@myuax.com>
# Time zone used for the session times in emails.
EMAIL_TIMEZONE=Europe/Madrid
# Base URL of the frontend for the links in emails (defaults to the first FRONTEND_ORIGIN).
# APP_URL=https://<your-vercel-app>.vercel.app

# CU-10 reminder scheduler (every 10 minutes inside the API process). Set to false to disable.
SCHEDULER_ENABLED=true

# Only for npm run test:db: a separate database, which those tests erase.
# TEST_DATABASE_URL=postgres://unimentor:unimentor@localhost:5432/unimentor_test
