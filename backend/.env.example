# Copy this file to .env and fill in the values. Never commit .env.

# Runtime environment: development | test | production
NODE_ENV=development

# Port the Express server listens on (Render injects its own PORT)
PORT=3000

# PostgreSQL connection string (local Postgres, or the Render "External Database URL")
DATABASE_URL=postgres://unimentor:unimentor@localhost:5432/unimentor

# Set to true when connecting to a database that requires SSL
# (e.g. the Render external URL from your machine). Render's internal URL does not need it.
DB_SSL=false

# Secret used to sign JWTs (ADR 4). Use a long random value in production.
JWT_SECRET=change-me

# Frontend origin(s) allowed by CORS with credentials (ADR 4), comma-separated.
# Local: Live Server / static server. Production: the Vercel URL.
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
